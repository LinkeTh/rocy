# Example environment configuration
# Copy this file to .env and adjust values as needed

# Server
BIND_ADDR=0.0.0.0:8080
RUST_LOG=info

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rocy

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=10485760
PER_FILE_MAX_BYTES=5242880

# Cookies
COOKIE_SECRET=SDs$2_Asdfas$2_Asdfas$SDs$2_Asdfas$2_Asdfas$2_SDs$2_Asdfas$2_Asdfas$2_Asdfas345Asdfas3452_Asdfas345§$SDs$2_Asdfas$2_Asdfas$2_Asdfas3452_Asdfas$2_AsdSDs$2_Asdfas$2_Asdfas$2_Asdfas345SDs$2_Asdfas$2_Asdfas$2_Asdfas345fas$2_Asdfas
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# OAuth (Google)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH_REDIRECT_URL=http://localhost:8080/auth/google/callback

LOGIN_REDIRECT_URL=http://localhost:4200/profile

# CORS
CORS_ALLOW_ORIGINS=*
